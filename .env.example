# ──────────────────────────────────────────────
# 환경변수 예시 파일 (git 추적 O — 실제 값 X)
# 복사 후 .env.local 로 이름을 바꿔 사용하세요.
# cp .env.example .env.local
# ──────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=구름상회

# ── Supabase (필수 — 없으면 API 라우트 동작 불가) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 인증 (필수) ──
ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=your-session-secret-min-32-chars  # openssl rand -hex 32

# ── 선택 ──
# TENANT_ID=your-tenant-uuid  (Supabase tenants 테이블의 id — 콜드스타트 최적화)
# KMA_API_KEY=  (기상청 API 키 — 없으면 목업 날씨로 폴백)

# ── 결제 (토스페이먼츠 — 연동 예정) ──
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
