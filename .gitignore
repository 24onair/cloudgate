# ── Next.js 앱용 .gitignore ─────────────────────────────
# (이전 파일은 Next.js 프레임워크 저장소용 템플릿이어서 교체함)

# build output
.next/
out/
dist/

# dependencies
node_modules/

# env — 예시(.env.example)와 배포 기본값(.env.production)만 추적
.env
.env.local
.env*.local

# logs
*.log
npm-debug.log*

# coverage
coverage/
.nyc_output/

# OS / editor
.DS_Store
**/.idea

# Vercel
.vercel

# cache
*.tsbuildinfo
.swc/
.turbo

# Claude Code (로컬 설정·세션 파일)
.claude/settings.local.json
.claude/plans/
.claude/todos.json
.claude/worktrees
CLAUDE.local.md

# Conductor (워크트리는 무시, scripts/ 는 추적)
.conductor/*/
!.conductor/scripts/

# gstack
.gstack/

# 로컬 격리 폴더 (삭제 전 임시 보관)
.trash-*/
